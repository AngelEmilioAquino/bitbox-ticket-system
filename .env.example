# Template for the PRODUCTION stack (docker-compose.prod.yml). Copy to .env and fill in real values.
# .env is git-ignored: never commit real secrets.
# The development stack (plain `docker compose up`) needs no .env at all.

# REQUIRED in production
JWT_SECRET=            # HS256 key, >= 32 bytes. Generate: openssl rand -base64 48
DB_PASSWORD=           # PostgreSQL password

# Optional
DB_NAME=bitbox_inventory
DB_USERNAME=bitbox
JWT_EXPIRATION=1h
# Development only: host port for PostgreSQL debug access
POSTGRES_PORT=5432
