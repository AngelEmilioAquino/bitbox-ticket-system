# REQUIRED in production
JWT_SECRET=            # HS256 key, >= 32 bytes. Generate: openssl rand -base64 48
DB_PASSWORD=           # PostgreSQL password
RABBITMQ_PASSWORD=     # RabbitMQ password
REDIS_PASSWORD=        # Redis password

# Optional
DB_NAME=bitbox_inventory
DB_USERNAME=bitbox
RABBITMQ_USERNAME=bitbox
REDIS_USERNAME=bitbox
JWT_EXPIRATION=1h
POSTGRES_PORT=5432
