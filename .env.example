# Copy to .env to override the defaults used by docker-compose.yml.
# All values below are DEVELOPMENT defaults. Never reuse them in a real environment.

DB_NAME=bitbox_inventory
DB_USERNAME=bitbox
DB_PASSWORD=bitbox
POSTGRES_PORT=5432

# HS256 signing key: at least 32 bytes. Generate one with:  openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
JWT_EXPIRATION=1h
